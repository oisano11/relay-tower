# =============================================================================
# Upstream Monitor & Switcher Console Environment Configuration
# =============================================================================

# Server Port
PORT=3300

# Environment Mode (production / development)
NODE_ENV=production

# Initial Admin Password for Console. Required for the first usable boot; do not commit the value.
# Leave this blank only if you intentionally want console login disabled until it is set and the service restarts.
ADMIN_PASSWORD=

# Optional fixed key for /v1. If blank, a random key is stored only in the protected runtime data volume.
GATEWAY_API_KEY=

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Sub2API Integration Mode
# Set to 'true' if running on the same VPS/host as Sub2API Docker container
IS_VPS=false

# Remote Sub2API SSH Connection (Optional, only needed if connecting to remote Sub2API over SSH)
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_KEY=

# Standalone Docker Compose: numeric group owner of /var/run/docker.sock on the target Linux host.
# Example discovery command: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# Persistent named volume used by the standalone Docker Compose deployment.
UPSTREAM_MONITOR_DATA_VOLUME=upstream-monitor-data
