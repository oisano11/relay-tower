# =============================================================================
# Sub2API Environment Variables Configuration Template
# =============================================================================

# Server Configuration
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
TZ=Asia/Shanghai

# Database Configuration (PostgreSQL)
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=sub2api

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0

# Security Secrets (IMPORTANT: Keep these fixed across restarts)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here
TOTP_ENCRYPTION_KEY=your_secure_totp_encryption_key_here

# Initial Admin Account (Auto-created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# Security / Allowlist Settings
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false

# Ops & Updates
OPS_ENABLED=true
UPDATE_PROXY_URL=

# =============================================================================
# Upstream Monitor & Switcher Console (Optional)
# =============================================================================
MONITOR_PORT=3300
MONITOR_ADMIN_PASSWORD=your_secure_monitor_password_here
TELEGRAM_BOT_TOKEN=

